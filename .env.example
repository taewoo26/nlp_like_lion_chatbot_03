# 이 파일을 .env 로 복사한 뒤 값을 채우세요. .env 는 절대 커밋하지 마세요.

# --- DB (docker-compose 와 파이썬 코드가 함께 사용) ---
POSTGRES_USER=admin
POSTGRES_PASSWORD=change-me-admin
POSTGRES_DB=pii_rag
RAG_PASSWORD=change-me-rag
VAULT_PASSWORD=change-me-vault
# 웹 데모 로그인 쿠키 서명 키. 16자 이상이어야 하고, 비어 있으면 웹 서버(uvicorn)가 시작되지 않습니다.
# 만들기: python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=
DB_HOST=localhost
DB_PORT=5432

# --- 임베딩 ---
# EMBED_PROVIDER=e5    : 로컬 sentence-transformers 모델 (현재 기본, API 키 불필요)
# EMBED_PROVIDER=api   : OpenAI 호환 임베딩 API (마스킹된 텍스트만 전송)
# EMBED_PROVIDER=local : 동작 확인용 해시 임베딩 (검색 품질 낮음, 테스트 전용)
EMBED_PROVIDER=e5
EMBED_MODEL_PATH=models/multilingual-e5-small-ko-v2
# DB 테이블 차원과 반드시 같아야 함. 바꾸면 docker compose down -v 후 다시 up
EMBED_DIM=384
# api 사용 시에만 필요
EMBED_API_BASE=https://api.example.com/v1
EMBED_MODEL=text-embedding-3-small

# --- LLM (OpenAI 호환 API, chat.py 에서 사용) ---
LLM_API_BASE=https://api.example.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# --- 출력 재검사 (starter/recheck.py: 화면에 나갈 LLM 답변·문서 조각을 다시 탐지) ---
# 없으면 기본값으로 동작합니다. 바꿀 때만 주석을 풀어 쓰세요.
# on | off (off 는 비교 실험용)
# RECHECK=on
# split_v3 (기본, 적재와 같은 탐지기) | union (재현율 우선, 오탐 많음)
# RECHECK_DETECTOR=split_v3
# 이 라벨이 나오면 답변 차단 (임시값, 팀 합의 필요). 비워 두면 차단하지 않고 토큰화
# RECHECK_BLOCK_LABELS=resident_registration_number,card_number,account_number

# --- 가명처리 ---
# HMAC 비밀키. 팀에서 임의의 긴 문자열로 정하고 절대 커밋하지 마세요.
HMAC_KEY=

# --- 적재 ---
# 한 번에 처리·커밋할 원본 문서 수 (python -m starter.ingest --batch-size 로도 변경). --reset 은 항상 한 번에 처리.
INGEST_BATCH=30
# 탐지·가명처리에 쓸 프로세스 수 (python -m starter.ingest --workers 로도 변경). 1 이면 병렬 없음. 워커마다 모델이 올라가 메모리를 씁니다.
INGEST_WORKERS=1
# PERSON_DICT=off --reset 전용. 06_grants.sh 적용 후 app_reset으로 연결.
APP_RESET_PASSWORD=
RESET_DSN=

# ---- 인물사전 판정 규칙 (PERSON_DICT=on 일 때): v1(기존, 기본) | v3
# v3 = 단서·역할 귀속 보정 + 같은 부서·이름 연결(추정에도 reg_id) + 동명이인 방어 + 검색 역할 필터 완화
# 규칙을 바꾸면 python -m starter.ingest --reset 으로 다시 적재하세요.
PERSON_RULES=v3

# --- BM25 하이브리드 검색 ---
# BM25_WEIGHT : 임베딩 점수에 합산할 BM25 가중치 (0 이면 BM25 끔, 기본 0.3)
# BM25_CUTOFF : on 이면 키워드가 있는 질의에서 BM25=0 문서를 제외 (기본 on)
BM25_WEIGHT=0.3
BM25_CUTOFF=on
# SCORE_RATIO : 1등 대비 이 비율 미만이면 반환 안 함 (0 이면 끔, 기본 0.7)
SCORE_RATIO=0.7
