# 이 파일을 .env 로 복사한 뒤 값을 채우세요. .env 는 절대 커밋하지 마세요.

# --- DB (docker-compose 와 파이썬 코드가 함께 사용) ---
POSTGRES_USER=admin
POSTGRES_PASSWORD=change-me-admin
POSTGRES_DB=pii_rag
RAG_PASSWORD=change-me-rag
VAULT_PASSWORD=change-me-vault
DB_HOST=localhost
DB_PORT=5432

# --- 임베딩 ---
# EMBED_PROVIDER=e5    : 로컬 sentence-transformers 모델 (현재 기본, API 키 불필요)
# EMBED_PROVIDER=api   : OpenAI 호환 임베딩 API (마스킹된 텍스트만 전송)
# EMBED_PROVIDER=local : 동작 확인용 해시 임베딩 (검색 품질 낮음, 테스트 전용)
EMBED_PROVIDER=e5
EMBED_MODEL_PATH=models/multilingual-e5-small-ko-v2
# DB 테이블 차원과 반드시 같아야 함. 바꾸면 docker compose down -v 후 다시 up
EMBED_DIM=384
# api 사용 시에만 필요
EMBED_API_BASE=https://api.example.com/v1
EMBED_MODEL=text-embedding-3-small

# --- LLM (OpenAI 호환 API, chat.py 에서 사용) ---
LLM_API_BASE=https://api.example.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# --- 가명처리 ---
# HMAC 비밀키. 팀에서 임의의 긴 문자열로 정하고 절대 커밋하지 마세요.
HMAC_KEY=

# --- 적재 ---
# 한 번에 처리·커밋할 원본 문서 수 (python -m starter.ingest --batch-size 로도 변경). --reset 은 항상 한 번에 처리.
INGEST_BATCH=30
# 탐지·가명처리에 쓸 프로세스 수 (python -m starter.ingest --workers 로도 변경). 1 이면 병렬 없음. 워커마다 모델이 올라가 메모리를 씁니다.
INGEST_WORKERS=1
