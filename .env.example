# 팀장이 값을 채운 .env 파일을 공유합니다. (cp .env.example .env 후 값 입력)
# .env는 절대 커밋하지 않습니다.

# ── LLM / 임베딩 ──
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
EMBEDDING_API_KEY=

# ── 가명처리 (팀 전체 같은 값 필수) ──
HMAC_SECRET=

# ── DB 컨테이너 (infra/docker-compose.yml) ──
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=pii_rag
POSTGRES_PORT=5432

RAG_DB_USER=rag_user
RAG_DB_PASSWORD=
VAULT_DB_USER=vault_user
VAULT_DB_PASSWORD=

# ── 파이썬 코드 접속용 (위 값과 맞춰서 작성) ──
DATABASE_URL_RAG=postgresql://rag_user:RAG_DB_PASSWORD값@localhost:5432/pii_rag
DATABASE_URL_VAULT=postgresql://vault_user:VAULT_DB_PASSWORD값@localhost:5432/pii_rag

# ── 기준 토큰 분류 모델 (미리 받아둔 폴더, 비우면 자동 다운로드) ──
MOAI_MODEL_DIR=
