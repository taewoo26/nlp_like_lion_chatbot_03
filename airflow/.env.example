# Airflow 전용 설정. 복사해서 airflow/.env 로 만들고 값을 채운다 (.env 는 Git 제외).
# 프로젝트 비밀값(HMAC_KEY, DSN 등)은 레포 루트 .env 를 그대로 쓴다.
AIRFLOW_UID=50000
AIRFLOW_ADMIN_PASSWORD=
AIRFLOW_META_PASSWORD=
# 32자 이상 임의 문자열 (PowerShell: [guid]::NewGuid().ToString("N"))
AIRFLOW_JWT_SECRET=
# 프로젝트 DB 주소: 로컬은 프로젝트 compose 의 서비스 이름 db, 서버는 인스턴스 B 사설 IP
PROJECT_DB_HOST=db
# 로컬 프로젝트 DB 의 Docker 네트워크 (docker compose -p pii_starter 기준)
PROJECT_DB_NETWORK=pii_starter_default
